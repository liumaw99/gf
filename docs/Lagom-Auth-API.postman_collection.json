{
  "info": {
    "_postman_id": "lagom-auth-001",
    "name": "Lagom Auth API",
    "description": "Lagom JWT 认证系统测试集合 — Register / Login / Refresh / Protected Routes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔓 Public",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ping",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ping"]
            }
          },
          "response": []
        },
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Register success', function () {",
                  "  pm.expect(jsonData.code).to.eql(0);",
                  "  pm.expect(jsonData.data).to.have.property('access_token');",
                  "  pm.expect(jsonData.data).to.have.property('refresh_token');",
                  "});",
                  "",
                  "if (jsonData.data && jsonData.data.access_token) {",
                  "  pm.collectionVariables.set('accessToken', jsonData.data.access_token);",
                  "  pm.collectionVariables.set('refreshToken', jsonData.data.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"name\": \"Lagom User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "邮箱密码注册。成功自动保存 access_token / refresh_token 到集合变量。"
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Login success', function () {",
                  "  pm.expect(jsonData.code).to.eql(0);",
                  "  pm.expect(jsonData.data).to.have.property('access_token');",
                  "  pm.expect(jsonData.data).to.have.property('refresh_token');",
                  "});",
                  "",
                  "if (jsonData.data && jsonData.data.access_token) {",
                  "  pm.collectionVariables.set('accessToken', jsonData.data.access_token);",
                  "  pm.collectionVariables.set('refreshToken', jsonData.data.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "邮箱密码登录。成功自动保存 token 到集合变量。"
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Refresh success', function () {",
                  "  pm.expect(jsonData.code).to.eql(0);",
                  "  pm.expect(jsonData.data).to.have.property('access_token');",
                  "});",
                  "",
                  "if (jsonData.data && jsonData.data.access_token) {",
                  "  pm.collectionVariables.set('accessToken', jsonData.data.access_token);",
                  "  pm.collectionVariables.set('refreshToken', jsonData.data.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "description": "用 refresh_token 换取新的 Token Pair。旧的 refresh_token 会被加入黑名单。"
          },
          "response": []
        }
      ]
    },
    {

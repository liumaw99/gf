# ============================================
# Lagom 本地开发环境变量示例
# 复制为 .env 后按需修改
# ============================================

# 数据库（Docker dev 环境，默认映射到 5433 避免与其他项目冲突）
LAGOM_DATABASE_DSN=postgres://lagom:lagom@localhost:5433/lagom?sslmode=disable

# Redis（Docker dev 环境，默认映射到 6380 避免与其他项目冲突）
LAGOM_REDIS_ADDR=localhost:6380

# AI API Key（必填，否则 release 模式启动失败）
DEEPSEEK_API_KEY=your-deepseek-api-key

# JWT Secret（生产环境必须修改）
# LAGOM_JWT_SECRET=change-this-in-production

# OAuth（按需配置）
# APPLE_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\n...
# GOOGLE_CLIENT_SECRET=your-google-client-secret

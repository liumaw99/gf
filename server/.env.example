# ============================================
# Lagom Server 环境变量模板
# ============================================
# 复制为 .env 并填入实际值
# 环境变量优先级高于 config.yaml
# ============================================

# 服务
# LAGOM_SERVER_PORT=8080
# LAGOM_SERVER_MODE=debug

# 数据库
# LAGOM_DATABASE_DSN=postgres://lagom:your_password@localhost:5432/lagom?sslmode=disable
# DB_PASSWORD=your_password

# Redis
# LAGOM_REDIS_ADDR=localhost:6379
# LAGOM_REDIS_PASSWORD=
# LAGOM_REDIS_DB=0
# LAGOM_REDIS_POOL_SIZE=20
# LAGOM_REDIS_MIN_IDLE_CONNS=5
# LAGOM_REDIS_MAX_RETRIES=3

# JWT（生产环境必须修改）
# LAGOM_JWT_SECRET=your-256-bit-secret-here

# AI 服务（必须配置）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# OPENAI_API_KEY=sk-your-openai-key-here

# Apple Sign In
# LAGOM_OAUTH_APPLE_CLIENT_ID=com.lagom.app
# LAGOM_OAUTH_APPLE_TEAM_ID=YOUR_TEAM_ID
# LAGOM_OAUTH_APPLE_KEY_ID=YOUR_KEY_ID
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Google Sign In
# LAGOM_OAUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
